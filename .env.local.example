# Google Tag Manager container (falls back to GTM-P8RGXRFT if unset)
NEXT_PUBLIC_GTM_ID=GTM-P8RGXRFT

# Formspree form ID — the part after /f/ in https://formspree.io/f/XXXXXXX
# Blocked until Spencer verifies the Formspree account on spencer@accelerateb2b.com.
# If this is unset the application form logs a loud console error and saves nothing.
NEXT_PUBLIC_FORMSPREE_ID=

# Calendly inline embed URL, e.g. https://calendly.com/accelerateb2b/discovery-call
# Used on both the booking step and the not-a-fit step. Calendly itself must be configured
# to redirect to /congrats on event scheduled — that redirect is what fires the GA4
# meeting-scheduled tag, so do not replace it with an in-app navigation.
NEXT_PUBLIC_CALENDLY_URL=

# NB the NEXT_PUBLIC_SANITY_* / SANITY_STUDIO_API_TOKEN vars that used to live here are gone —
# the site is served from committed content and nothing reads them any more.
